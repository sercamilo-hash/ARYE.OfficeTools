<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ARYE Office Tools — two Revit add-in buttons from BauTools: Region Area → Param and Light & Vent.
    Revit 2026 · .NET 8. The Revit API comes from Nice3point's reference-only packages:
    ExcludeAssets="runtime" keeps RevitAPI.dll out of the output (it is Autodesk's, loaded by Revit).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ARYE.OfficeTools</RootNamespace>
    <AssemblyName>ARYE.OfficeTools</AssemblyName>
    <RevitVersion>2026</RevitVersion>
    <!-- Same constants BauTools defines for Revit 2026, so promoted code compiles unchanged. -->
    <DefineConstants>$(DefineConstants);REVIT2026;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER;REVIT2026_OR_GREATER</DefineConstants>
    <Version>1.4.0</Version>
    <Company>ARYE</Company>
    <Product>ARYE Office Tools</Product>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
