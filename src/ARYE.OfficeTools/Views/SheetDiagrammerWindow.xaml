<Window x:Class="ARYE.OfficeTools.Views.SheetDiagrammerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:steps="clr-namespace:ARYE.OfficeTools.Views.Steps"
        Title="BauTools — Sheet Diagrammer"
        Width="1500" Height="860"
        MinWidth="1200" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Dg.Page}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ARYE.OfficeTools;component/Views/Themes/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/ARYE.OfficeTools;component/Views/Themes/DiagrammerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar: the tool, the building it draws, the model, and what is unsaved. -->
        <Border Grid.Row="0" Style="{StaticResource Dg.Card}" Margin="12,12,12,0" Padding="14,9">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"
                            ToolTip="Step 4 · Sheets: reads the buildings and typical floors set in Zoning Floor Area; builds sheet sets, views and the sheet matrix.">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Dg.Accent}" Margin="0,0,10,0">
                        <Path Data="M 2,2 L 16,2 L 16,16 L 2,16 Z M 2,9 L 16,9 M 9,2 L 9,16" Stroke="{StaticResource Dg.White}" StrokeThickness="1.6"
                              StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None" />
                    </Border>
                    <TextBlock Text="Sheet Diagrammer" Style="{StaticResource Dg.Text}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Border DockPanel.Dock="Left" Width="1" Background="{StaticResource Dg.Line}" Margin="16,2" />
                <ComboBox DockPanel.Dock="Left" MinWidth="150" VerticalAlignment="Center" FontWeight="SemiBold"
                          ItemsSource="{Binding SheetLayout.Buildings}" SelectedItem="{Binding SheetLayout.SelectedBuilding}"
                          IsEnabled="{Binding SheetLayout.HasBuildings}" ToolTipService.ShowOnDisabled="True"
                          ToolTip="The building this run draws. Sets are shared by all buildings; each run is one set for one building. Buildings come from Zoning Floor Area › Step 1." />
                <TextBlock DockPanel.Dock="Left" Margin="14,0,0,0" VerticalAlignment="Center" Style="{StaticResource Dg.MutedText}" TextWrapping="NoWrap"
                           Text="{Binding DocumentTitle}" TextTrimming="CharacterEllipsis" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource Dg.Warn}" Margin="0,0,6,0" VerticalAlignment="Center"
                             Visibility="{Binding SheetLayout.IsDirty, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding SheetLayout.DirtyCaption}" Style="{StaticResource Dg.MutedText}" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,14,0"
                               ToolTip="Whether the sets differ from what is stored in the model. Generate also saves." />
                    <Button Content="Refresh" Style="{StaticResource Dg.Button}" Command="{Binding RefreshCommand}" Margin="0,0,8,0"
                            ToolTip="Re-read buildings, typical floors, sets, titleblocks, templates, sheet collections and browser organization from the model." />
                    <Button Content="Save sets" Style="{StaticResource Dg.PrimaryButton}" Command="{Binding SaveCommand}"
                            ToolTip="Persist the sheet sets in the model so the whole office shares them. Generate also saves." />
                </StackPanel>
            </DockPanel>
        </Border>

        <steps:Step4Sheets Grid.Row="1" DataContext="{Binding SheetLayout}" />

        <Border Grid.Row="2" Background="{StaticResource Dg.Panel}" BorderBrush="{StaticResource Dg.Line}" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="120" Height="6" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource Dg.MutedText}" Text="{Binding StatusText}" TextWrapping="NoWrap" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
