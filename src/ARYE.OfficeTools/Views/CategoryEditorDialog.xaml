<Window x:Class="ARYE.OfficeTools.Views.CategoryEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BauTools — ZFA Categories"
        Width="560" Height="520" MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Absolute pack URI: inside Revit, relative URIs resolve against
                     Revit.exe (the host app), not this assembly, and the load fails. -->
                <ResourceDictionary Source="pack://application:,,,/ARYE.OfficeTools;component/Views/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource Text.Header}" Margin="0,0,0,4"
                   Text="ZFA categories" />
        <TextBlock Grid.Row="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Each name is the exact 'ZFA Category' value written on Areas (matched case-insensitively). The role decides where the square feet land: Main Gross is the base of NET, Commercial Gross is tracked separately and never enters NET, each Deduction gets its own matrix column, Exempt counts in no total. The list is stored with the project." />

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RowsControl"
                              ToolTip="The project's category list, in matrix column order.">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0,0,8,0"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Category name — the exact 'ZFA Category' parameter value (matched case-insensitively, trimmed). Renaming here does NOT rewrite existing parameter values: areas still carrying the old name become Unclassified on the next harvest." />
                                <ComboBox Grid.Column="1" Margin="0,0,8,0"
                                          ItemsSource="{Binding RoleOptions}"
                                          SelectedItem="{Binding SelectedRole}"
                                          ToolTip="Role of this category in the matrix arithmetic: Main Gross (base of NET), Commercial Gross (informational column), Deduction (own column, subtracted from gross), Exempt (counts in no total)." />
                                <Button Grid.Column="2" Content="✕" Style="{StaticResource Button.Danger}"
                                        Padding="8,4" Click="OnDeleteRowClick"
                                        ToolTip="Remove this category from the list. Areas still carrying its name are NOT touched — they simply become Unclassified on the next harvest and show up in the amber banner." />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="3" Content="+ Add category" Style="{StaticResource Button.Secondary}"
                HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnAddRowClick"
                ToolTip="Append a new category to the list. Give it the exact 'ZFA Category' value your areas carry and pick its role." />

        <TextBlock Grid.Row="4" x:Name="ValidationText" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource Brush.Danger}" Visibility="Collapsed"
                   ToolTip="What blocks saving the list." />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"
                    Click="OnCancelClick"
                    ToolTip="Close without changing the category list." />
            <Button Content="Save categories" Style="{StaticResource Button.Confirm}"
                    Click="OnSaveClick"
                    ToolTip="Store this list in the project configuration. The matrix columns, the harvest matching and the Step 2 filter all follow it — recompute the matrix afterwards." />
        </StackPanel>
    </Grid>
</Window>
