<UserControl x:Class="ARYE.OfficeTools.Views.Steps.Step2AreaMapping"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- A UserControl's own InitializeComponent runs before it is attached
                     to any parent window, so it cannot see MainWindow's merged theme —
                     each step control merges it independently. -->
                <ResourceDictionary Source="pack://application:,,,/ARYE.OfficeTools;component/Views/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,6,0" />
            </Style>

            <!-- ⓘ hint; the ToolTip carries the long explanation. -->
            <Style x:Key="HintGlyph" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                <Setter Property="Text" Value="ⓘ" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Cursor" Value="Help" />
                <Setter Property="ToolTipService.ShowDuration" Value="20000" />
            </Style>

            <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="ColHead" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="Num" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            </Style>

            <!-- One range in the left list: state stripe, name, subtitle, state pill. -->
            <Style x:Key="RangeItem" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="card" Background="{StaticResource Brush.Background}"
                                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                    CornerRadius="6" Opacity="{Binding Opacity}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{Binding StripeBrush}"
                                            CornerRadius="6,0,0,6" />
                                    <StackPanel Grid.Column="1" Margin="10,8,10,8">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Secondary}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        <Border HorizontalAlignment="Left" CornerRadius="9" Padding="8,1"
                                                Margin="0,6,0,0" Background="{Binding PillBackground}"
                                                Visibility="{Binding HasPill, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding PillText}" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{Binding PillForeground}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                    <Setter TargetName="card" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Topbar ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Check again" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"
                            Command="{Binding CheckCommand}"
                            ToolTip="Measure every range of this building against its source again. Read-only: nothing in the model changes." />
                    <Button Content="{Binding SyncAllText}" Style="{StaticResource Button.Secondary}"
                            Command="{Binding SyncAllCommand}" ToolTipService.ShowOnDisabled="True"
                            ToolTip="Sync every range that is not In sync, after a single confirmation that lists all of them. One Undo reverts them all." />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Building" Style="{StaticResource FieldLabel}" />
                    <ComboBox Width="170" ItemsSource="{Binding Buildings}" SelectedItem="{Binding SelectedBuilding}"
                              Margin="0,0,16,0"
                              ToolTip="The building whose ranges are listed below. Buildings and their ranges are defined in Step 1." />
                    <TextBlock Text="Area schemes" Style="{StaticResource FieldLabel}" />
                    <ItemsControl ItemsSource="{Binding SchemeOptions}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}"
                                          Margin="0,0,14,0" VerticalAlignment="Center"
                                          ToolTip="Tick every area scheme that holds this building's ZFA areas (for example Gross Building and Deductions). Each ticked scheme is synced range by range, and the Step 3 matrix reads all of them. Areas are classified by their ZFA Category, whatever scheme they sit in. Saved per building." />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── Ranges list ────────────────────────────────────────────── -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="RANGES" Style="{StaticResource SectionLabel}" />
                        <TextBlock Style="{StaticResource HintGlyph}"
                                   ToolTip="Each Typical or Duplex range from Step 1. The source level is the truth; every other level of the range is a copy of it. Single floors are listed for reference and are drawn by hand." />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Style="{StaticResource Text.Secondary}"
                               Margin="0,8,0,0"
                               Text="Status is measured every time this tab opens. Nothing changes in the model until you confirm a sync." />
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Style="{StaticResource Text.Secondary}"
                               FontSize="12" Margin="0,0,0,8"
                               Text="This building has no Typical or Duplex range. Define one in Step 1."
                               Visibility="{Binding HasNoRanges, Converter={StaticResource BoolToVis}}" />
                    <ListBox ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}"
                             ItemContainerStyle="{StaticResource RangeItem}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </DockPanel>
            </Border>

            <!-- ── Selected range ─────────────────────────────────────────── -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Background="{StaticResource Brush.Background}"
                    Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Header: what this range is and why it is in its state -->
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Border CornerRadius="9" Padding="10,2" Margin="0,0,10,0" VerticalAlignment="Center"
                                        Background="{Binding StatePillBackground}">
                                    <TextBlock Text="{Binding StatePillText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding StatePillForeground}" />
                                </Border>
                                <Button Content="Sync range" Command="{Binding SyncCommand}" Padding="18,8"
                                        FontWeight="SemiBold" ToolTipService.ShowOnDisabled="True"
                                        ToolTip="{Binding SyncButtonToolTip}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource Text.Header}" />
                                <TextBlock Text="{Binding DetailWhy}" TextWrapping="Wrap" FontSize="12.5"
                                           Margin="0,4,0,0" MaxWidth="620" HorizontalAlignment="Left" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Notes: atypical levels skipped, shared scheme, … -->
                        <ItemsControl ItemsSource="{Binding Notes}" Margin="0,0,0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource Brush.Warning}"
                                               TextWrapping="Wrap" Margin="0,0,0,2"><Run Text="⚠ " /><Run Text="{Binding Mode=OneWay}" /></TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Unenclosed source areas -->
                        <Border Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6"
                                Padding="10,8" Margin="0,0,0,10"
                                Visibility="{Binding HasUnenclosed, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding UnenclosedText}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="#991B1B" />
                        </Border>

                        <!-- Inline confirmation: says what is deleted before anything is -->
                        <Border BorderBrush="{StaticResource Brush.Accent}" BorderThickness="1" CornerRadius="6"
                                Background="#F5F9FF" Padding="14,12" Margin="0,0,0,10"
                                Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding ConfirmTitle}" FontWeight="SemiBold" FontSize="13"
                                           Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding ConfirmLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,3"><Run Text="•  " /><Run Text="{Binding Mode=OneWay}" /></TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding ConfirmDeleteText}" TextWrapping="Wrap" FontSize="12.5"
                                           FontWeight="SemiBold" Foreground="{StaticResource Brush.Danger}"
                                           Margin="12,2,0,6" />
                                <TextBlock Text="One Undo in Revit reverts the whole sync." Style="{StaticResource Text.Secondary}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="Cancel" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"
                                            Command="{Binding CancelSyncCommand}" />
                                    <Button Content="{Binding ConfirmButtonText}" Style="{StaticResource Button.Confirm}"
                                            FontWeight="SemiBold" Command="{Binding ConfirmSyncCommand}"
                                            ToolTip="Delete the listed elements and rebuild every copy from the source, then measure." />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Result of the last sync -->
                        <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,10" BorderThickness="1"
                                Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FEF3C7" />
                                    <Setter Property="BorderBrush" Value="#FDE68A" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ResultIsClean}" Value="True">
                                            <Setter Property="Background" Value="#D1FAE5" />
                                            <Setter Property="BorderBrush" Value="#A7F3D0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontSize="12.5" />
                        </Border>

                        <!-- Check table: every level against the source -->
                        <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <Border Background="{StaticResource Brush.Card}" CornerRadius="6,6,0,0" Padding="12,8"
                                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Check · every level against the source" FontWeight="SemiBold"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding LastSyncedText}" Style="{StaticResource Text.Secondary}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource HintGlyph}"
                                                   ToolTip="Measured from the model. A copy matches when it has the same areas (name and ZFA Category) with the same square footage as the source, within 0.01 sf, and the same number of boundary lines." />
                                    </StackPanel>
                                </Border>
                                <Grid Margin="12,6,12,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Level" Style="{StaticResource ColHead}" />
                                    <TextBlock Grid.Column="1" Text="Areas" Style="{StaticResource ColHead}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="Gross sf" Style="{StaticResource ColHead}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="Deductions sf" Style="{StaticResource ColHead}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="Net sf" Style="{StaticResource ColHead}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="Status" Style="{StaticResource ColHead}" Margin="14,0,0,0" />
                                    <TextBlock Grid.Column="6" Text="Detail" Style="{StaticResource ColHead}" Margin="6,0,0,0" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding LevelRows}" Margin="0,0,0,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                            <Border Background="{StaticResource Brush.Card}" Padding="12,7,12,4"
                                                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"
                                                    Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding HeaderText}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#334155" />
                                            </Border>
                                            <Border Background="{Binding RowBackground}" Padding="12,4"
                                                    BorderBrush="#F1F5F9" BorderThickness="0,1,0,0"
                                                    Visibility="{Binding IsRow, Converter={StaticResource BoolToVis}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="50" />
                                                        <ColumnDefinition Width="95" />
                                                        <ColumnDefinition Width="95" />
                                                        <ColumnDefinition Width="95" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding LevelName}" FontSize="12"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding AreaCount}" Style="{StaticResource Num}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Gross}" Style="{StaticResource Num}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Deductions}" Style="{StaticResource Num}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Net}" Style="{StaticResource Num}" />
                                                    <Border Grid.Column="5" HorizontalAlignment="Left" Margin="14,0,0,0"
                                                            CornerRadius="9" Padding="7,1" VerticalAlignment="Center"
                                                            Background="{Binding StatusBackground}">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10.5" FontWeight="SemiBold"
                                                                   Foreground="{Binding StatusForeground}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="6" Text="{Binding Detail}" Margin="6,0,0,0"
                                                               Style="{StaticResource Text.Secondary}" FontSize="11.5"
                                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- What gets copied -->
                        <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <Border Background="{StaticResource Brush.Card}" CornerRadius="6,6,0,0" Padding="12,8"
                                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="What gets copied" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="everything on the source plans, every category, per scheme"
                                                   Style="{StaticResource Text.Secondary}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource HintGlyph}"
                                                   ToolTip="Every area and boundary line on the source plan is copied. Areas without a ZFA Category are copied too and show as Unclassified here: classify them on the source (or in Step 3) so the matrix can count them." />
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding SourceAreaRows}" Margin="12,6,12,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                            <TextBlock Text="{Binding HeaderText}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#334155" Margin="0,6,0,3"
                                                       Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}" />
                                            <Grid Margin="0,2" Visibility="{Binding IsRow, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1" HorizontalAlignment="Left" CornerRadius="3"
                                                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                                        Padding="6,0">
                                                    <TextBlock Text="{Binding Category}" FontSize="10.5" FontWeight="SemiBold"
                                                               Foreground="{Binding CategoryForeground}" />
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding SquareFeet}" Style="{StaticResource Num}" />
                                            </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Options -->
                        <Expander Header="Options" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}"
                                  ToolTip="Settings that apply to every sync of this project.">
                            <StackPanel Orientation="Horizontal" Margin="16,6,0,0">
                                <TextBlock Text="Building parameter" Style="{StaticResource FieldLabel}" />
                                <ComboBox Width="220" ItemsSource="{Binding BuildingParameterOptions}"
                                          SelectedItem="{Binding SelectedBuildingParameter}"
                                          ToolTip="A text parameter on Areas. When set, every copied area gets the building's name written into it. Saved with the project configuration." />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
