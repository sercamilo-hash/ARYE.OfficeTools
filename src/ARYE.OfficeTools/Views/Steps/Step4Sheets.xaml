<UserControl x:Class="ARYE.OfficeTools.Views.Steps.Step4Sheets"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:sheets="clr-namespace:ARYE.OfficeTools.Views.Sheets">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ARYE.OfficeTools;component/Views/Themes/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/ARYE.OfficeTools;component/Views/Themes/DiagrammerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <Style x:Key="HintGlyph" TargetType="TextBlock" BasedOn="{StaticResource Dg.MutedText}">
                <Setter Property="Text" Value="ⓘ" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Cursor" Value="Help" />
                <Setter Property="ToolTipService.ShowDuration" Value="20000" />
            </Style>

            <!-- One set in the list. -->
            <Style x:Key="Dg.SetItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Border x:Name="bd" Background="Transparent" BorderBrush="{StaticResource Dg.Line}" BorderThickness="0,1,0,0" Padding="12,9">
                                    <ContentPresenter />
                                </Border>
                                <Border x:Name="bar" Width="3" HorizontalAlignment="Left" Margin="0,8" CornerRadius="0,3,3,0" Background="{StaticResource Dg.Accent}" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Dg.Panel2}" /></Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Dg.AccentSoft}" />
                                    <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="ViewRowTemplate">
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="52" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{Binding ColorBrush}" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="ExtraBold" Foreground="{StaticResource Dg.White}" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding LevelName}" Style="{StaticResource Dg.Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ViewName}" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Dg.MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Detail}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ContentRowTemplate">
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Mark}" Foreground="{Binding MarkBrush}" FontWeight="Bold" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding SheetNumber}" Style="{StaticResource Dg.Text}" FontWeight="SemiBold" />
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding ViewName}" Style="{StaticResource Dg.Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ViewName}" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Dg.MutedText}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="SlotTemplate">
                <Border Background="{Binding Fill}" BorderBrush="{Binding Stroke}" BorderThickness="1" CornerRadius="2" Margin="1" Opacity="{Binding Opacity}">
                    <TextBlock Text="{Binding Label}" FontSize="8" Foreground="{Binding TextBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="1,0" />
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="MiniSheetTemplate">
                <StackPanel Margin="0,0,10,10">
                    <Border Width="{Binding Width}" Height="{Binding Height}" Background="{StaticResource Dg.Panel}"
                            BorderBrush="{StaticResource Dg.Line2}" BorderThickness="1" CornerRadius="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl Grid.Column="0" ItemsSource="{Binding Slots}" Margin="3" ItemTemplate="{StaticResource SlotTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <primitives:UniformGrid
                                            Columns="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            Rows="{Binding DataContext.Rows, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Border Grid.Column="1" Width="{Binding StripWidth}" Background="{Binding StripFill}" Margin="0,1,1,1" CornerRadius="0,2,2,0" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding SheetNumber}" Style="{StaticResource Dg.Text}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SheetName}" />
                    <TextBlock Text="{Binding StatusCaption}" FontSize="10" Foreground="{Binding CaptionBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DataTemplate>

            <!-- One browser-organization parameter: name + editable value combo, marked while empty. -->
            <DataTemplate x:Key="ParameterRowTemplate">
                <Border Style="{StaticResource Dg.FieldRow}" Tag="{Binding Level}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Dg.Label}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}" />
                            <TextBlock Style="{StaticResource Dg.NeedText}" Text="{Binding Level}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding Options}"
                                  Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                  ToolTip="Pick a value already in use, or type a new one. Empty = leave the parameter alone." />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- One additional existing view of the set. -->
            <DataTemplate x:Key="AdditionalViewTemplate">
                <Border Background="{StaticResource Dg.Panel2}" BorderBrush="{StaticResource Dg.Line}" BorderThickness="1" CornerRadius="7" Padding="9,6" Margin="0,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Dg.Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Dg.MutedText}" FontSize="11">
                                <Run Text="{Binding TypeName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Content="own sheet" IsChecked="{Binding OwnSheet}" VerticalAlignment="Center" Margin="8,0" FontSize="12"
                                  ToolTip="Checked: a dedicated 1×1 sheet in this set. Unchecked: the next free slot of the matrix, after the plan views." />
                        <Button Grid.Column="2" Content="✕" Style="{StaticResource Dg.IconButton}"
                                Command="{Binding DataContext.RemoveAdditionalViewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="Remove from the set. Nothing is deleted in Revit." />
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- ── LEFT: the sets, then the building's floors ─────────────────── -->
        <DockPanel Grid.Column="0">
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Dg.Card}" Margin="0,12,0,0" Padding="14,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="FLOORS OF THE BUILDING" Style="{StaticResource Dg.Caps}" />
                        <TextBlock Style="{StaticResource HintGlyph}"
                                   ToolTip="Buildings and their typical floors come from Zoning Floor Area › Step 1 and are read-only here. A run is always one set for one building; its scope box crops every created view." />
                    </StackPanel>
                    <TextBlock Text="{Binding BuildingCaption}" Style="{StaticResource Dg.MutedText}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding TypicalFloorRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource Dg.Text}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding LevelsCaption}">
                                        <Run Text="{Binding GroupName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding LevelsCaption, Mode=OneWay}" Foreground="{StaticResource Dg.Muted}" FontSize="11" />
                                    </TextBlock>
                                    <Border Grid.Column="1" Style="{StaticResource Dg.Tag}" Tag="{Binding TagState}" Margin="6,0,0,0"
                                            ToolTip="Single: drawn on its own. Typical or Duplex: one source level stands for the whole range.">
                                        <TextBlock Style="{StaticResource Dg.TagText}" Tag="{Binding TagState}" Text="{Binding KindCaption}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Dg.Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,12,14,8">
                        <TextBlock Text="SHEET SETS" Style="{StaticResource Dg.Caps}" />
                        <TextBlock Style="{StaticResource HintGlyph}"
                                   ToolTip="A set is a reusable sheet series: what to draw, how to number it, which titleblock frames it, which sheet collection and browser values it carries, and how many views fit on one sheet. Sets are saved in the model and shared with the office. Re-running only adds what is missing." />
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource Dg.Panel2}" BorderBrush="{StaticResource Dg.Line}" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Add" Style="{StaticResource Dg.Button}" Command="{Binding AddPackageCommand}" Margin="0,0,6,0"
                                    ToolTipService.ShowOnDisabled="True" ToolTip="Add an empty set. Stored when you press Save sets." />
                            <Button Content="Duplicate" Style="{StaticResource Dg.Button}" Command="{Binding DuplicatePackageCommand}" Margin="0,0,6,0"
                                    ToolTipService.ShowOnDisabled="True" ToolTip="Copy the selected set under a new name and identity. The copy owns no sheets until generated." />
                            <Button Content="Remove" Style="{StaticResource Dg.DangerButton}" Command="{Binding RemovePackageCommand}"
                                    ToolTipService.ShowOnDisabled="True" ToolTip="Remove the set definition. Sheets and views it created stay in the model; nothing is deleted in Revit." />
                        </StackPanel>
                    </Border>
                    <ListBox ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource Dg.SetItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ToolTip="The sheet sets stored with this project. Select one to edit it and preview its run.">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Dg.Text}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding NumberCaption}" Style="{StaticResource Dg.MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="NoWrap" />
                                        <Border Style="{StaticResource Dg.Tag}" Tag="{Binding ListStatus}"
                                                ToolTip="Required: Generate stays disabled until it is filled. Recommended: optional but worth filling. Ready: nothing missing.">
                                            <TextBlock Style="{StaticResource Dg.TagText}" Tag="{Binding ListStatus}" Text="{Binding ListStatusCaption}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- ── CENTER: the selected set, in three steps ───────────────────── -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <TextBlock Text="Select or add a set on the left." Margin="4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Dg.MutedText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPackage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel DataContext="{Binding SelectedPackage}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Setup progress -->
                    <Border Style="{StaticResource Dg.Card}" Padding="14,10" Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Setup" Style="{StaticResource Dg.Text}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Border Style="{StaticResource Dg.Tag}" Tag="Required" Margin="6,0,0,0" ToolTip="Settings that must be filled before Generate works."
                                        Visibility="{Binding HasRequired, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource Dg.TagText}" Tag="Required"><Run Text="{Binding RequiredCount, Mode=OneWay}" /><Run Text=" required" /></TextBlock>
                                </Border>
                                <Border Tag="Recommended" Margin="6,0,0,0" ToolTip="Settings you can leave empty, but that make the result better.">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Dg.Tag}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RecommendedCount}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Style="{StaticResource Dg.TagText}" Tag="Recommended"><Run Text="{Binding RecommendedCount, Mode=OneWay}" /><Run Text=" recommended" /></TextBlock>
                                </Border>
                            </StackPanel>
                            <ProgressBar Style="{StaticResource Dg.Progress}" Value="{Binding SetupPercent, Mode=OneWay}" Width="180" Margin="0,0,12,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding SetupCaption}" Style="{StaticResource Dg.MutedText}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        </DockPanel>
                    </Border>

                    <!-- ── Step 1 · What to draw ── -->
                    <Border Style="{StaticResource Dg.Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <ToggleButton Style="{StaticResource Dg.StepToggle}" IsChecked="{Binding Step1Open, Mode=TwoWay}"
                                          ToolTip="Which plans this set draws, and how the views are named. Click to open or close.">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Dg.StepNum}" Tag="{Binding Step1State}" Margin="0,0,11,0">
                                        <TextBlock Text="1" Tag="{Binding Step1State}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Dg.StepNumText}">
                                                    <Style.Triggers><DataTrigger Binding="{Binding Step1State}" Value="Complete"><Setter Property="Text" Value="✓" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="What to draw" Style="{StaticResource Dg.Text}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Border Grid.Column="2" Style="{StaticResource Dg.Tag}" Tag="{Binding Step1State}" Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource Dg.TagText}" Tag="{Binding Step1State}" Text="{Binding Step1Tag}" />
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding Step1Summary}" Style="{StaticResource Dg.MutedText}" TextAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Path Grid.Column="4" Style="{StaticResource Dg.Chevron1}" />
                                </Grid>
                            </ToggleButton>
                            <StackPanel Margin="14,0,14,16" Visibility="{Binding Step1Open, Converter={StaticResource BoolToVis}}">
                                <Border Height="1" Background="{StaticResource Dg.Line}" Margin="0,0,0,4" />

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Dg.Label}" Text="Set name" />
                                    <TextBox Grid.Column="1" Text="{Binding Name}" ToolTip="Display name, e.g. 'Gross'. Uppercased into every sheet name it creates." />
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Dg.Label}" Text="Draw" />
                                    <Border Grid.Column="1" HorizontalAlignment="Left" Background="{StaticResource Dg.Panel2}" BorderBrush="{StaticResource Dg.Line2}" BorderThickness="1" CornerRadius="7" Padding="1">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Dg.Segment}" Content="Floor plans" GroupName="Step4Source" IsChecked="{Binding IsFloorPlans}" ToolTip="The model's floor plan views, one per level." />
                                            <RadioButton Style="{StaticResource Dg.Segment}" Content="Area plans" GroupName="Step4Source" IsChecked="{Binding IsAreaPlans}" ToolTip="The area plans of the scheme below, one per level." />
                                            <RadioButton Style="{StaticResource Dg.Segment}" Content="Ceiling plans" GroupName="Step4Source" IsChecked="{Binding IsCeilingPlans}" ToolTip="The model's reflected ceiling plans, one per level." />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border x:Name="Row_scheme" Style="{StaticResource Dg.FieldRow}" Tag="{Binding AreaSchemeLevel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Dg.Label}" Text="Area scheme" />
                                            <TextBlock Style="{StaticResource Dg.NeedText}" Text="{Binding AreaSchemeLevel}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <ComboBox ItemsSource="{Binding AreaSchemeOptions}" SelectedItem="{Binding AreaScheme}" DisplayMemberPath="Name"
                                                      IsEnabled="{Binding IsAreaSchemeEnabled}" ToolTipService.ShowOnDisabled="True"
                                                      ToolTip="Only used, and only enabled, when the source is Area plans." />
                                            <TextBlock Style="{StaticResource Dg.WhyText}" Tag="{Binding AreaSchemeLevel}" Text="{Binding AreaSchemeWhy}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="Row_template" Style="{StaticResource Dg.FieldRow}" Tag="{Binding ViewTemplateLevel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Dg.Label}" Text="View template" />
                                            <TextBlock Style="{StaticResource Dg.NeedText}" Text="{Binding ViewTemplateLevel}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <ComboBox ItemsSource="{Binding ViewTemplateOptions}" SelectedItem="{Binding ViewTemplate}" DisplayMemberPath="Name"
                                                      ToolTip="Applied to every view the set creates or updates. Only templates that can be assigned to the source kind are offered. '(none)' assigns nothing and clears nothing." />
                                            <TextBlock Style="{StaticResource Dg.WhyText}" Tag="{Binding ViewTemplateLevel}" Text="{Binding ViewTemplateWhy}" />
                                            <TextBlock Text="{Binding ViewTemplateCaption}" Style="{StaticResource Dg.MutedText}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Dg.Label}" Text="View name" />
                                    <TextBox Grid.Column="1" Text="{Binding ViewNameSuffix, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="Text added after the level in every view this set creates, e.g. 'GROSS AREA' gives '2ND FL. GROSS AREA' and a Typical range gives '3RD TO 7TH FL. GROSS AREA'. Empty gives just '2ND FL.'. Views this set already owns are renamed on the next run; a name another view already uses gets the building appended." />
                                </Grid>

                                <StackPanel x:Name="Rows_viewparam" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding ViewOrganizationCaption}" Style="{StaticResource Dg.MutedText}" Margin="0,8,0,0" />
                                    <ItemsControl ItemsSource="{Binding ViewParameters}" ItemTemplate="{StaticResource ParameterRowTemplate}" />
                                </StackPanel>

                                <CheckBox Margin="0,14,0,0" Content="One view per floor-range row" IsChecked="{Binding RestrictToFloorRangeLevels}"
                                          ToolTip="On (default): one view per row of the building's floor list. Each Single floor gets its own view; each Typical range gets one view, the source level's plan, titled e.g. '3RD TO 7TH FL.'; each Duplex range gets two ('LOWER' and 'UPPER'). The other levels of a range get no view of their own. Off: every matching view in the model draws, one per level, even ones with no Floor Range assignment." />
                                <TextBlock Style="{StaticResource Dg.MutedText}" Margin="22,2,0,0"
                                           Text="Single floors get their own view; a Typical range gets one, from its source level. Turn off to draw every level." />

                                <TextBlock Text="{Binding DataContext.PlannedViewsCaption, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Dg.Caps}" Margin="0,16,0,0" />
                                <ItemsControl ItemsSource="{Binding DataContext.PlannedViews, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,6,0,0"
                                              ToolTip="The views this run will keep up to date: new ones and the ones this set already owns. A highlighted chip is the one view that stands for a whole Typical or Duplex range.">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="9,3" Margin="0,0,6,6" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource Dg.Panel2}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource Dg.Line}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRange}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource Dg.AccentSoft}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource Dg.AccentLine}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Dg.Text}" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Area table -->
                                <Border Height="1" Background="{StaticResource Dg.Line}" Margin="0,12,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Area table" Style="{StaticResource Dg.SubTitle}" />
                                    <TextBlock Style="{StaticResource HintGlyph}"
                                               ToolTip="Every view of this set also gets an area table, filtered to that view's level and put on the sheet. Each table is a copy of an area schedule you pick, so its columns, sorting, totals and formatting stay yours; only the Building and Level filters, the name, the browser values and the template change. Tables this set made are updated on the next run and never touch a schedule it did not make." />
                                </StackPanel>
                                <CheckBox Content="Add an area table to each view" IsChecked="{Binding AddAreaTable}" Margin="0,8,0,0"
                                          ToolTip="On: every view of this set gets its own area table. Off: the set draws views only." />
                                <TextBlock Style="{StaticResource Dg.MutedText}" Margin="22,2,0,0"
                                           Text="One table per view, filtered to that view's level. For a Typical range, the table lists its source level." />
                                <StackPanel Visibility="{Binding AddAreaTable, Converter={StaticResource BoolToVis}}">
                                    <Border x:Name="Row_areatable" Style="{StaticResource Dg.FieldRow}" Tag="{Binding AreaTableLevel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Dg.Label}" Text="Table to copy" />
                                                <TextBlock Style="{StaticResource Dg.NeedText}" Text="{Binding AreaTableLevel}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <ComboBox ItemsSource="{Binding AreaTableOptions}" SelectedItem="{Binding AreaTable}" DisplayMemberPath="Name"
                                                          ToolTip="An existing area schedule. Each new table is a copy of it, so its fields, sorting, grouping and totals stay as you made them. Only the Building and Level filters, the name and the parameters change." />
                                                <TextBlock Style="{StaticResource Dg.WhyText}" Tag="{Binding AreaTableLevel}" Text="{Binding AreaTableWhy}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Dg.Label}" Text="Table template" />
                                        <StackPanel Grid.Column="1">
                                            <ComboBox ItemsSource="{Binding AreaTableViewTemplateOptions}" SelectedItem="{Binding AreaTableViewTemplate}" DisplayMemberPath="Name"
                                                      ToolTip="A view template for schedules, applied to every table this set creates or updates. (none) leaves each copy as the original is." />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Dg.Label}" Text="Table name" />
                                        <StackPanel Grid.Column="1">
                                            <TextBox Text="{Binding AreaTableNamePattern, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="The name of each table. Tokens: {set} the set's name, {building} the building's name in Zoning Floor Area, {building value} the text the areas carry in their Building parameter, {level} the level or range label ('2ND FLOOR', '3RD TO 7TH FLOOR'). Empty uses '{set} - {building} - {level}'. A name another view already uses gets the building appended." />
                                            <TextBlock Style="{StaticResource Dg.MutedText}" Margin="0,4,0,0">
                                                <Run Text="Tokens: {set} {building} {building value} {level}. Example: " /><Run Text="{Binding AreaTableNameSample, Mode=OneWay}" FontWeight="SemiBold" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Dg.Label}" Text="Building value" />
                                        <StackPanel Grid.Column="1">
                                            <TextBox Text="{Binding AreaTableBuildingValue, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="The text the table's Building filter and Building parameter use. It has to match the Building value on the areas (for example BUILDING A). Empty uses the building's name in Zoning Floor Area." />
                                            <TextBlock Style="{StaticResource Dg.MutedText}" Margin="0,4,0,0" Text="Empty uses the building's name. It must match what the areas carry in their Building parameter." />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Dg.Label}" Text="Place the table" />
                                        <StackPanel Grid.Column="1">
                                            <ComboBox ItemsSource="{Binding PlacementOptions}" SelectedItem="{Binding SelectedPlacement}" DisplayMemberPath="Label"
                                                      ToolTip="Where each table goes. Under or beside its view: the cell is split between the two, and the scale is sized for the space the view keeps. In a cell of its own: after the views, one cell per table. In a fixed place: all of a sheet's tables stack along one edge of the usable area." />
                                            <TextBlock Style="{StaticResource Dg.MutedText}" Margin="0,4,0,0"
                                                       Text="A table next to its view takes space from it: the scale is sized for what is left, and the preview says how big each table is." />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,10,0,0" Visibility="{Binding IsEdgePlacement, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Dg.Label}" Text="Fixed place" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding EdgeOptions}" SelectedItem="{Binding SelectedEdge}" DisplayMemberPath="Label"
                                                  ToolTip="The edge of the usable area where all of a sheet's tables stack, in view order. The views keep the rest of the area." />
                                    </Grid>
                                    <Grid Margin="0,10,0,0" Visibility="{Binding UsesGap, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Dg.Label}" Text="Gap, inches" />
                                        <TextBox Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding AreaTableGapText, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="Space between a view and its table, or between stacked tables, in inches." />
                                    </Grid>
                                </StackPanel>

                                <!-- Additional views -->
                                <Border Height="1" Background="{StaticResource Dg.Line}" Margin="0,12,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Additional views" Style="{StaticResource Dg.SubTitle}" />
                                    <TextBlock Style="{StaticResource HintGlyph}"
                                               ToolTip="Existing views (sections, 3D, legends, schedules…) placed on this set's sheets exactly as they are: never duplicated, never restyled. 'Own sheet' gives the view a dedicated 1×1 sheet; otherwise it takes the next free matrix slot after the plan views. A view already on a sheet this set does not own is skipped and reported." />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding AdditionalViews}" ItemTemplate="{StaticResource AdditionalViewTemplate}" />
                                <TextBlock Text="None yet." Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Dg.MutedText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAdditionalViews}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Content="Add existing views…" Style="{StaticResource Dg.Button}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Command="{Binding DataContext.AddAdditionalViewsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="Pick views from the model. Views already on a sheet are shown as such." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── Step 2 · Where it goes ── -->
                    <Border Style="{StaticResource Dg.Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <ToggleButton Style="{StaticResource Dg.StepToggle}" IsChecked="{Binding Step2Open, Mode=TwoWay}"
                                          ToolTip="The titleblock, scope box, numbering, collection and browser values of the sheets. Click to open or close.">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Dg.StepNum}" Tag="{Binding Step2State}" Margin="0,0,11,0">
                                        <TextBlock Text="2" Tag="{Binding Step2State}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Dg.StepNumText}">
                                                    <Style.Triggers><DataTrigger Binding="{Binding Step2State}" Value="Complete"><Setter Property="Text" Value="✓" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Where it goes" Style="{StaticResource Dg.Text}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Border Grid.Column="2" Style="{StaticResource Dg.Tag}" Tag="{Binding Step2State}" Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource Dg.TagText}" Tag="{Binding Step2State}" Text="{Binding Step2Tag}" />
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding Step2Summary}" Style="{StaticResource Dg.MutedText}" TextAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Path Grid.Column="4" Style="{StaticResource Dg.Chevron2}" />
                                </Grid>
                            </ToggleButton>
                            <StackPanel Margin="14,0,14,16" Visibility="{Binding Step2Open, Converter={StaticResource BoolToVis}}">
                                <Border Height="1" Background="{StaticResource Dg.Line}" Margin="0,0,0,4" />

                                <Border x:Name="Row_titleblock" Style="{StaticResource Dg.FieldRow}" Tag="{Binding TitleBlockLevel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Dg.Label}" Text="Titleblock" />
                                            <TextBlock Style="{StaticResource Dg.NeedText}" Text="{Binding TitleBlockLevel}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <ComboBox ItemsSource="{Binding TitleBlockOptions}" SelectedItem="{Binding TitleBlock}" DisplayMemberPath="Name"
                                                      ToolTip="The titleblock type framing every sheet of this set. Its Sheet Width / Height decide the slot size, so the recommended scale follows from it." />
                                            <TextBlock Style="{StaticResource Dg.WhyText}" Tag="{Binding TitleBlockLevel}" Text="{Binding TitleBlockWhy}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="Row_scopebox" Style="{StaticResource Dg.FieldRow}" Tag="{Binding ScopeBoxLevel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Dg.Label}" Text="Scope box" />
                                            <TextBlock Style="{StaticResource Dg.NeedText}" Text="{Binding ScopeBoxLevel}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <ComboBox ItemsSource="{Binding ScopeBoxOptions}" SelectedItem="{Binding ScopeBox}" DisplayMemberPath="Name"
                                                      ToolTip="Crops every view this set CREATES. Default: the building's scope box from Zoning Floor Area › Step 1. Applied at creation only: views the set already owns keep their crop." />
                                            <TextBlock Style="{StaticResource Dg.WhyText}" Tag="{Binding ScopeBoxLevel}" Text="{Binding ScopeBoxWhy}" />
                                            <CheckBox Content="also re-apply to views this set already owns" IsChecked="{Binding ReapplyScopeBoxOnUpdate}" Margin="0,8,0,0"
                                                      ToolTip="Off (default): the scope box is applied only when a view is created. On: every run re-crops the views this set owns with the scope box above. Foreign views are never touched." />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Dg.Label}" Text="Sheet numbers" />
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding NumberPrefix}" Margin="0,0,5,0" ToolTip="Prefix, e.g. 'Z-' gives Z-100, Z-101…" />
                                        <TextBox Grid.Column="1" Text="{Binding StartNumber}" Margin="0,0,5,0" ToolTip="First number of the series. Positions used by this set's own sheets are consumed; numbers held by other sheets are skipped and listed." />
                                        <TextBox Grid.Column="2" Text="{Binding NumberIncrement}" ToolTip="Step between consecutive sheet numbers." />
                                    </Grid>
                                </Grid>

                                <Border x:Name="Row_collection" Style="{StaticResource Dg.FieldRow}" Tag="{Binding CollectionLevel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Dg.Label}" Text="Sheet collection" />
                                            <TextBlock Style="{StaticResource Dg.NeedText}" Text="{Binding CollectionLevel}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <ComboBox IsEditable="True" ItemsSource="{Binding SheetCollectionOptions}" Text="{Binding SheetCollectionName, UpdateSourceTrigger=LostFocus}"
                                                      ToolTip="Pick an existing Sheet Collection or type a new name: it is created on the next run. Empty = none." />
                                            <TextBlock Style="{StaticResource Dg.WhyText}" Tag="{Binding CollectionLevel}" Text="{Binding CollectionWhy}" />
                                            <TextBlock Text="{Binding SheetCollectionNote}" Style="{StaticResource Dg.MutedText}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="Rows_sheetparam" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SheetOrganizationCaption}" Style="{StaticResource Dg.MutedText}" Margin="0,8,0,0" />
                                    <ItemsControl ItemsSource="{Binding SheetParameters}" ItemTemplate="{StaticResource ParameterRowTemplate}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── Step 3 · Layout on the sheet ── -->
                    <Border Style="{StaticResource Dg.Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <ToggleButton Style="{StaticResource Dg.StepToggle}" IsChecked="{Binding Step3Open, Mode=TwoWay}"
                                          ToolTip="How many views per sheet, the scale, the cell sizes and where on the titleblock they go. Click to open or close.">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Dg.StepNum}" Tag="Complete" Margin="0,0,11,0">
                                        <TextBlock Text="3" Style="{StaticResource Dg.StepNumText}" Tag="Complete" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Layout on the sheet" Style="{StaticResource Dg.Text}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Step3Summary}" Style="{StaticResource Dg.MutedText}" TextAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Path Grid.Column="3" Style="{StaticResource Dg.Chevron3}" />
                                </Grid>
                            </ToggleButton>
                            <StackPanel Margin="14,0,14,16" Visibility="{Binding Step3Open, Converter={StaticResource BoolToVis}}">
                                <Border Height="1" Background="{StaticResource Dg.Line}" Margin="0,0,0,4" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource Dg.Label}" Text="Columns, rows" />
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                        <ComboBox ItemsSource="{Binding GridOptions}" SelectedItem="{Binding Columns}" MinWidth="60" ToolTip="Slots across the sheet, 1 to 4." />
                                        <TextBlock Text="×" Style="{StaticResource Dg.Text}" FontSize="14" VerticalAlignment="Center" Margin="10,0" />
                                        <ComboBox ItemsSource="{Binding GridOptions}" SelectedItem="{Binding Rows}" MinWidth="60" ToolTip="Slots down the sheet, 1 to 4." />
                                        <TextBlock Text="slots per sheet" Style="{StaticResource Dg.MutedText}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Style="{StaticResource Dg.Label}" Text="Scale" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ScaleOptions}" SelectedItem="{Binding SelectedScale}" DisplayMemberPath="Label" Margin="0,0,0,8"
                                              ToolTip="Auto = the largest standard scale at which the building's footprint fits a slot with annotation margin. Or fix one; if the footprint does not fit, the run is blocked and says so. With unequal cells the scale is sized for the smallest one. A view template that controls View Scale decides it instead." />
                                    <TextBlock Grid.Row="2" Style="{StaticResource Dg.Label}" Text="Cells" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="Make all equal" Style="{StaticResource Dg.SmallButton}" Command="{Binding EqualCellsCommand}"
                                                ToolTip="Drag the dashed separators in the viewer below to resize cells; this puts every cell back to the same size." />
                                        <TextBlock Text="{Binding CellsCaption}" Style="{StaticResource Dg.MutedText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="3" Style="{StaticResource Dg.Label}" Text="Separators" />
                                    <CheckBox Grid.Row="3" Grid.Column="1" Content="draw them as Detail Lines on each sheet" IsChecked="{Binding DrawSeparatorLines}" Margin="0,6,0,8"
                                              ToolTip="On: every sheet this set creates or already owns gets the separator lines between its cells, as Detail Lines tagged to this set (re-running replaces only those). Off: the lines are guides in this window only and nothing is drawn." />
                                    <TextBlock Grid.Row="4" Style="{StaticResource Dg.Label}" Text="Line style" />
                                    <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding LineStyleOptions}" SelectedItem="{Binding SeparatorLineStyle}"
                                              IsEnabled="{Binding DrawSeparatorLines}" ToolTipService.ShowOnDisabled="True"
                                              ToolTip="The Revit line style of the separators. Only used when the separators are drawn." />
                                </Grid>

                                <Border Height="1" Background="{StaticResource Dg.Line}" Margin="0,14,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="View area on the titleblock" Style="{StaticResource Dg.SubTitle}" />
                                    <TextBlock Style="{StaticResource HintGlyph}"
                                               ToolTip="The titleblock is rendered exactly as it prints (a temporary sheet exported to an image and rolled back: the model does not change). The blue rectangle is where viewports go; drag its edges (1/8 inch steps) or type the four margins in inches. The dashed lines are the separators between cells: drag one to resize the cells on either side (it snaps back to equal when close). The orange lines are the titleblock family's own; the view area snaps to them. The red-dashed box in the first slot is the actual footprint at the run's scale, with its walls: real feedback on whether it fits; content that spills past the slot means the scale or matrix is too tight. Saved with the set." />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Dg.MutedText}" Margin="0,2,0,6" Text="Drag the blue edges, or type the margins in inches. The dashed lines are the separators between cells." />
                                <WrapPanel Margin="0,0,0,6">
                                    <CheckBox Content="snap to titleblock lines" IsChecked="{Binding SnapToTitleBlock}" Margin="0,0,14,4"
                                              ToolTip="Dragging an edge of the blue view area pulls it onto the nearest line of the titleblock family (frame, title strip, boxes) within the distance at the right. Hold Alt while dragging to place it freely." />
                                    <CheckBox Content="show the lines" IsChecked="{Binding ShowTitleBlockLines}" Margin="0,0,14,4"
                                              ToolTip="Draws the titleblock family's own straight lines (orange) over the image so you can see what it will snap to." />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="distance" Style="{StaticResource Dg.MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" TextWrapping="NoWrap" />
                                        <ComboBox ItemsSource="{Binding SnapDistanceOptions}" SelectedItem="{Binding SnapDistanceIn}" MinWidth="64"
                                                  ToolTip="How close an edge must come to a titleblock line, in inches, before it snaps to it." />
                                    </StackPanel>
                                </WrapPanel>
                                <sheets:TitleBlockLayoutControl Height="300"
                                                                ImagePath="{Binding TitleBlockImagePath}"
                                                                SheetWidthIn="{Binding TitleBlockSheetWidthIn}"
                                                                SheetHeightIn="{Binding TitleBlockSheetHeightIn}"
                                                                MarginLeftIn="{Binding MarginLeftIn, Mode=TwoWay}"
                                                                MarginRightIn="{Binding MarginRightIn, Mode=TwoWay}"
                                                                MarginTopIn="{Binding MarginTopIn, Mode=TwoWay}"
                                                                MarginBottomIn="{Binding MarginBottomIn, Mode=TwoWay}"
                                                                Columns="{Binding Columns}" Rows="{Binding Rows}"
                                                                ColumnCumulative="{Binding ColumnCumulative, Mode=TwoWay}"
                                                                RowCumulative="{Binding RowCumulative, Mode=TwoWay}"
                                                                TitleBlockLines="{Binding TitleBlockLines}"
                                                                SnapEnabled="{Binding SnapToTitleBlock}"
                                                                ShowTitleBlockLines="{Binding ShowTitleBlockLines}"
                                                                DrawSeparatorLines="{Binding DrawSeparatorLines}"
                                                                SnapDistanceIn="{Binding SnapDistanceIn}"
                                                                StatusText="{Binding TitleBlockImageStatus}"
                                                                PreviewWidthFt="{Binding ScopeBoxPreviewWidthFt}"
                                                                PreviewHeightFt="{Binding ScopeBoxPreviewHeightFt}"
                                                                PreviewLines="{Binding ScopeBoxPreviewLines}"
                                                                PreviewScaleDenominator="{Binding EffectiveScaleDenominator}" />
                                <WrapPanel Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,2" ToolTip="Blue: the view area. Dashed or solid: the separators between cells.">
                                        <Border Width="18" Height="2" Background="#0071E3" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="view area" Style="{StaticResource Dg.MutedText}" TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,2" ToolTip="Straight lines of the titleblock family; the view area snaps to them.">
                                        <Border Width="18" Height="2" Background="#D97706" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="titleblock line / snap guide" Style="{StaticResource Dg.MutedText}" TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,2" ToolTip="The first cell shows the real footprint at the run's scale. Content past the cell edge means the scale or matrix is too tight.">
                                        <Border Width="18" Height="2" Background="#DC2626" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="content at scale (cell 1)" Style="{StaticResource Dg.MutedText}" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </WrapPanel>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="Left" Style="{StaticResource Dg.MutedText}" /><TextBox Text="{Binding MarginLeftIn, UpdateSourceTrigger=LostFocus, StringFormat=0.##}" ToolTip="Left margin, inches" /></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,6,0"><TextBlock Text="Right" Style="{StaticResource Dg.MutedText}" /><TextBox Text="{Binding MarginRightIn, UpdateSourceTrigger=LostFocus, StringFormat=0.##}" ToolTip="Right margin, inches. Typically the title strip." /></StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,6,0"><TextBlock Text="Top" Style="{StaticResource Dg.MutedText}" /><TextBox Text="{Binding MarginTopIn, UpdateSourceTrigger=LostFocus, StringFormat=0.##}" ToolTip="Top margin, inches" /></StackPanel>
                                    <StackPanel Grid.Column="3"><TextBlock Text="Bottom" Style="{StaticResource Dg.MutedText}" /><TextBox Text="{Binding MarginBottomIn, UpdateSourceTrigger=LostFocus, StringFormat=0.##}" ToolTip="Bottom margin, inches" /></StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,12,0,0">
                                    <Border Style="{StaticResource Dg.Tag}" Background="{StaticResource Dg.AccentSoft}" Margin="0,0,6,4"><TextBlock Style="{StaticResource Dg.TagText}" Foreground="{StaticResource Dg.Accent2}" Text="{Binding AreaReadout}" /></Border>
                                    <Border Style="{StaticResource Dg.Tag}" Background="{StaticResource Dg.OkSoft}" Margin="0,0,6,4"><TextBlock Style="{StaticResource Dg.TagText}" Foreground="{StaticResource Dg.Ok}" Text="{Binding ScaleReadout}" /></Border>
                                </WrapPanel>
                                <ItemsControl ItemsSource="{Binding CellRows}" ToolTip="The size of every cell of the matrix, in reading order. Unequal sizes mean you dragged a separator.">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                <TextBlock Text="{Binding Number}" Width="26" Style="{StaticResource Dg.MutedText}" TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding Width}" Width="80" Style="{StaticResource Dg.Text}" />
                                                <TextBlock Text="{Binding Height}" Style="{StaticResource Dg.Text}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ── RIGHT: what the run would do ──────────────────────────────── -->
        <Border Grid.Column="4" Style="{StaticResource Dg.Card}">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Dg.Panel2}" BorderBrush="{StaticResource Dg.Line}" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="14,11">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Generate and place" Style="{StaticResource Dg.PrimaryButton}" Command="{Binding GenerateCommand}"
                                ToolTipService.ShowOnDisabled="True" ToolTip="{Binding GenerateTooltip}" />
                        <Button DockPanel.Dock="Right" Content="Preview" Style="{StaticResource Dg.Button}" Command="{Binding PreviewCommand}" Margin="0,0,8,0"
                                ToolTipService.ShowOnDisabled="True" ToolTip="{Binding PreviewTooltip}" />
                        <TextBlock Text="{Binding FooterNote}" Style="{StaticResource Dg.MutedText}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    </DockPanel>
                </Border>

                <StackPanel DockPanel.Dock="Top" Margin="14,12,14,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="RESULT" Style="{StaticResource Dg.Caps}" />
                        <TextBlock Style="{StaticResource HintGlyph}"
                                   ToolTip="Read-only: nothing changes until you press Generate and place. NEW views do not exist yet; UPDATE views are ones this set already owns; KEPT views were created earlier but are no longer source levels; PLACE are the additional existing views. It updates with every change you make. Views and sheets this set does not own are never touched." />
                        <TextBlock Text="updates as you change anything" Style="{StaticResource Dg.MutedText}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                    </StackPanel>

                    <Border Style="{StaticResource Dg.Verdict}" Tag="{Binding VerdictKind}" Margin="0,10,0,0"
                            ToolTip="Whether this run can go ahead, and whether the sheets will hold only the views this set expects.">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Dg.VerdictGlyph}" Tag="{Binding VerdictKind}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Dg.VerdictTitle}" Tag="{Binding VerdictKind}" Text="{Binding VerdictTitle}" />
                                <TextBlock Text="{Binding VerdictDetail}" Style="{StaticResource Dg.Text}" FontSize="12" Foreground="{StaticResource Dg.Ink2}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <WrapPanel Margin="0,12,0,0">
                        <Border Style="{StaticResource Dg.Kpi}" Opacity="{Binding KpiOpacity}"><StackPanel><TextBlock Style="{StaticResource Dg.KpiValue}" Text="{Binding KpiViews}" /><TextBlock Style="{StaticResource Dg.MutedText}" FontSize="10.5" Text="views" /></StackPanel></Border>
                        <Border Style="{StaticResource Dg.Kpi}" Opacity="{Binding KpiOpacity}"><StackPanel><TextBlock Style="{StaticResource Dg.KpiValue}" Text="{Binding KpiSheets}" /><TextBlock Style="{StaticResource Dg.MutedText}" FontSize="10.5" Text="sheets" /></StackPanel></Border>
                        <Border Style="{StaticResource Dg.Kpi}" Opacity="{Binding KpiOpacity}"><StackPanel><TextBlock Style="{StaticResource Dg.KpiValue}" Text="{Binding KpiScale}" /><TextBlock Style="{StaticResource Dg.MutedText}" FontSize="10.5" Text="{Binding KpiScaleCaption}" /></StackPanel></Border>
                        <Border Style="{StaticResource Dg.Kpi}"><StackPanel><TextBlock Style="{StaticResource Dg.KpiValue}" Text="{Binding KpiCells}" /><TextBlock Style="{StaticResource Dg.MutedText}" FontSize="10.5" Text="cells per sheet" /></StackPanel></Border>
                        <Border Style="{StaticResource Dg.Kpi}" Visibility="{Binding HasKpiCollection, Converter={StaticResource BoolToVis}}"><StackPanel><TextBlock Style="{StaticResource Dg.KpiValue}" Text="{Binding KpiCollection}" /><TextBlock Style="{StaticResource Dg.MutedText}" FontSize="10.5" Text="sheet collection" /></StackPanel></Border>
                    </WrapPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,0">
                    <StackPanel Margin="14,0,14,12">
                        <!-- Still to fill in -->
                        <Border Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}" BorderBrush="{StaticResource Dg.Line}" BorderThickness="1" CornerRadius="7" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="TO FILL IN" Style="{StaticResource Dg.Caps}" Background="{StaticResource Dg.Panel2}" Padding="11,7" />
                                <ItemsControl ItemsSource="{Binding Issues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.GoToIssueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    ToolTip="{Binding Why}" HorizontalContentAlignment="Stretch">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="Transparent" BorderBrush="{StaticResource Dg.Line}" BorderThickness="0,1,0,0" Padding="11,8">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Dg.AccentSoft}" /></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Level}" Style="{StaticResource Dg.NeedText}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource Dg.Text}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="Go to it ›" Foreground="{StaticResource Dg.Accent2}" FontWeight="SemiBold" FontSize="12" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Scope box -->
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,4">
                            <TextBlock Text="SCOPE BOX" Style="{StaticResource Dg.Caps}" />
                            <TextBlock Style="{StaticResource HintGlyph}"
                                       ToolTip="The crop area created views will get, at scale, with whatever walls fall inside it as reference lines, read directly from the model, not a rendered view. Deliberately incomplete: just enough to confirm this is the right area before Generate." />
                        </StackPanel>
                        <sheets:ScopeBoxPreviewControl Height="110"
                                                       WidthFt="{Binding SelectedPackage.ScopeBoxPreviewWidthFt}"
                                                       HeightFt="{Binding SelectedPackage.ScopeBoxPreviewHeightFt}"
                                                       Lines="{Binding SelectedPackage.ScopeBoxPreviewLines}"
                                                       Note="{Binding SelectedPackage.ScopeBoxPreviewNote}" />
                        <TextBlock Text="{Binding LastGeneratedText}" Style="{StaticResource Dg.MutedText}" Margin="0,8,0,0" />

                        <!-- NEW / UPDATE / KEPT / PLACE -->
                        <WrapPanel Margin="0,10,0,0" ToolTip="NEW: created by this run. UPDATE: already owned, template and values re-applied. KEPT: built earlier, no longer a source level. PLACE: additional existing views.">
                            <Border Style="{StaticResource Dg.Pill}" Tag="NEW"><TextBlock Text="NEW" FontSize="9" FontWeight="ExtraBold" Foreground="{StaticResource Dg.White}" /></Border>
                            <TextBlock Text="{Binding NewCount}" Style="{StaticResource Dg.MutedText}" Margin="5,0,12,0" TextWrapping="NoWrap" />
                            <Border Style="{StaticResource Dg.Pill}" Tag="UPDATE"><TextBlock Text="UPDATE" FontSize="9" FontWeight="ExtraBold" Foreground="{StaticResource Dg.White}" /></Border>
                            <TextBlock Text="{Binding UpdateCount}" Style="{StaticResource Dg.MutedText}" Margin="5,0,12,0" TextWrapping="NoWrap" />
                            <Border Style="{StaticResource Dg.Pill}" Tag="KEPT"><TextBlock Text="KEPT" FontSize="9" FontWeight="ExtraBold" Foreground="{StaticResource Dg.White}" /></Border>
                            <TextBlock Text="{Binding KeptCount}" Style="{StaticResource Dg.MutedText}" Margin="5,0,12,0" TextWrapping="NoWrap" />
                            <Border Style="{StaticResource Dg.Pill}" Tag="PLACE"><TextBlock Text="PLACE" FontSize="9" FontWeight="ExtraBold" Foreground="{StaticResource Dg.White}" /></Border>
                            <TextBlock Text="{Binding PlaceCount}" Style="{StaticResource Dg.MutedText}" Margin="5,0,0,0" TextWrapping="NoWrap" />
                        </WrapPanel>

                        <!-- Sheets -->
                        <TextBlock Text="SHEETS" Style="{StaticResource Dg.Caps}" Margin="0,14,0,6" />
                        <ItemsControl ItemsSource="{Binding MiniSheets}" ItemTemplate="{StaticResource MiniSheetTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="green slot = added by this run · dimmed slot = empty" Style="{StaticResource Dg.MutedText}" FontSize="10.5" />

                        <!-- Groups -->
                        <Expander Style="{StaticResource Dg.Group}" Visibility="{Binding HasContentCheck, Converter={StaticResource BoolToVis}}"
                                  ToolTip="Every view that will be on this set's sheets after the run, with its sheet number. Updates with every change you make.">
                            <Expander.Header>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Dg.Tag}" Tag="Ready"><TextBlock Style="{StaticResource Dg.TagText}" Tag="Ready" Text="{Binding ExpectedCountText}" /></Border>
                                    <TextBlock Text="✓  Expected on the sheets" Style="{StaticResource Dg.Text}" FontWeight="SemiBold" />
                                </DockPanel>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding ExpectedRows}" ItemTemplate="{StaticResource ContentRowTemplate}" />
                        </Expander>

                        <Expander Style="{StaticResource Dg.Group}" IsExpanded="True" Visibility="{Binding HasUnexpected, Converter={StaticResource BoolToVis}}"
                                  ToolTip="Views already on this set's sheets that are not in the expected list. A run never removes or moves a viewport, so they stay until you delete them in Revit.">
                            <Expander.Header>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Dg.Tag}" Tag="Recommended"><TextBlock Style="{StaticResource Dg.TagText}" Tag="Recommended" Text="{Binding UnexpectedCountText}" /></Border>
                                    <TextBlock Text="⚠  Older views still on the sheets" Style="{StaticResource Dg.Text}" FontWeight="SemiBold" />
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Dg.MutedText}" Text="Built by this set earlier, or placed by hand. A run never removes viewports, so these stay until you remove them in Revit." Margin="0,2,0,4" />
                                <ItemsControl ItemsSource="{Binding UnexpectedRows}" ItemTemplate="{StaticResource ContentRowTemplate}" />
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource Dg.Group}" Visibility="{Binding HasTables, Converter={StaticResource BoolToVis}}"
                                  ToolTip="The area tables of this run: NEW ones are copied from your table, UPDATE ones were made by this set before and get their filters, name and template re-applied. A table this set did not make is never touched.">
                            <Expander.Header>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Dg.Tag}"><TextBlock Style="{StaticResource Dg.TagText}" Text="{Binding TablesCountText}" /></Border>
                                    <TextBlock Text="Area tables" Style="{StaticResource Dg.Text}" FontWeight="SemiBold" />
                                </DockPanel>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding TableRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="58" />
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource Dg.Pill}" Tag="{Binding Status}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,8,0">
                                                <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="ExtraBold" Foreground="{StaticResource Dg.White}" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding SheetNumber}" Style="{StaticResource Dg.Text}" FontWeight="SemiBold" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Dg.Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Dg.MutedText}" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <Expander Style="{StaticResource Dg.Group}" ToolTip="Every view of this run and what happens to it.">
                            <Expander.Header>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Dg.Tag}"><TextBlock Style="{StaticResource Dg.TagText}" Text="{Binding ViewsCountText}" /></Border>
                                    <TextBlock Text="Views" Style="{StaticResource Dg.Text}" FontWeight="SemiBold" />
                                </DockPanel>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding ViewRows}" ItemTemplate="{StaticResource ViewRowTemplate}" />
                        </Expander>

                        <Expander Style="{StaticResource Dg.Group}" IsExpanded="True" Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"
                                  ToolTip="Things worth knowing before you generate.">
                            <Expander.Header>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Dg.Tag}" Tag="Recommended"><TextBlock Style="{StaticResource Dg.TagText}" Tag="Recommended" Text="{Binding NotesCountText}" /></Border>
                                    <TextBlock Text="⚠  Notes" Style="{StaticResource Dg.Text}" FontWeight="SemiBold" />
                                </DockPanel>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding Notes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Dg.Text}" FontSize="12" Foreground="{StaticResource Dg.Warn}" TextWrapping="Wrap" Margin="0,3"><Run Text="⚠ " /><Run Text="{Binding Mode=OneWay}" /></TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
